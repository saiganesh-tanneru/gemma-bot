# Gemma-Bot environment configuration (copy to .env and customize as needed)

# Embedded HTTP command server host/port
GEMMA_BOT_HOST=127.0.0.1
GEMMA_BOT_PORT=8765
# Optional full URL override for remote clients (e.g. Raspberry Pi Zero thin client)
# GEMMA_BOT_URL=http://127.0.0.1:8765

# Optional authentication token for HTTP /command requests (required if binding 0.0.0.0)
GEMMA_BOT_TOKEN=
GEMMA_MAX_BODY_BYTES=16384

# Voice Server & Web UI (integrated pipeline)
GEMMA_VOICE_HOST=0.0.0.0
GEMMA_VOICE_PORT=8000
GEMMA_VOICE_CLIENT_PORT=5173
GEMMA_TALK_WS_URL=ws://127.0.0.1:8000/ws/events
GEMMA_STT_ENGINE=sarvam
GEMMA_INDIC_LANG=te
GEMMA_VOICE_TTS_ENGINE=sarvam
# GEMMA_MODELS_DIR=./voice_server/models

# Webots application path
# WEBOTS_APP=/Applications/Webots.app/Contents/MacOS/webots

# Timeouts (seconds)
GEMMA_BRIDGE_TIMEOUT=1.5
GEMMA_BRIDGE_HEALTH_TIMEOUT=1.0
GEMMA_BRIDGE_HEALTH_INTERVAL=5.0
GEMMA_CLI_COMMAND_TIMEOUT=3.0
GEMMA_CLI_STATUS_TIMEOUT=2.0

# Speech / TTS ("sarvam", "mac_say", or "null")
GEMMA_TTS_PROVIDER=sarvam
GEMMA_TTS_MAC_VOICE=Samantha

# Sarvam AI (keep API key in environment only; never commit)
SARVAM_API_KEY=
GEMMA_SARVAM_STT_MODEL=saaras:v4
GEMMA_SARVAM_STT_LANGUAGE=unknown
GEMMA_SARVAM_STT_MODE=transcribe
GEMMA_SARVAM_TTS_MODEL=bulbul:v3
GEMMA_SARVAM_TTS_SPEAKER=shubh
GEMMA_SARVAM_TTS_LANGUAGE=en-IN
GEMMA_SARVAM_TTS_TIMEOUT=5.0

# LLM Intent Parser ("sarvam" or "keyword")
GEMMA_INTENT_PROVIDER=sarvam
GEMMA_SARVAM_LLM_MODEL=sarvam-105b
GEMMA_INTENT_TIMEOUT=4.0
