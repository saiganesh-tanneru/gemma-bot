# Gemma-Bot environment configuration (copy to .env and customize as needed)

# Embedded HTTP command server host/port
GEMMA_BOT_HOST=127.0.0.1
GEMMA_BOT_PORT=8765
# Optional full URL override for remote clients (e.g. Raspberry Pi Zero thin client)
# GEMMA_BOT_URL=http://127.0.0.1:8765

# Optional authentication token for HTTP /command requests (required if binding 0.0.0.0)
GEMMA_BOT_TOKEN=

# Gemma-Talk WebSocket endpoint & directory
GEMMA_TALK_WS_URL=ws://localhost:8000/ws
# GEMMA_TALK_DIR=~/Documents/gemma-talk

# Webots application path
# WEBOTS_APP=/Applications/Webots.app/Contents/MacOS/webots

# Timeouts (seconds)
GEMMA_BRIDGE_TIMEOUT=1.5
GEMMA_BRIDGE_HEALTH_TIMEOUT=1.0
GEMMA_BRIDGE_HEALTH_INTERVAL=5.0
GEMMA_CLI_COMMAND_TIMEOUT=3.0
GEMMA_CLI_STATUS_TIMEOUT=2.0
